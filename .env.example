# Copy to .env and fill in with your own values. .env is gitignored.
#
# WORKER_URL     the deployed Worker's address, printed by `wrangler deploy`
# CF_ACCOUNT_ID  from the Cloudflare dashboard URL; used only to build dashboard links
# CONTROL_TOKEN  shared secret for the routes that write or spend. Must match the
#                Worker secret: `npx wrangler secret put CONTROL_TOKEN`. Rotate by
#                setting both again — the Worker reads whichever value is current.
#
# Shell use:
#   set -a; . ./.env; set +a
#   curl "$WORKER_URL/usage"

WORKER_URL=https://your-worker.your-subdomain.workers.dev
CF_ACCOUNT_ID=your-cloudflare-account-id
CONTROL_TOKEN=a-long-random-string
