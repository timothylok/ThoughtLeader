{
  "name": "cf-research-loop",
  "version": "1.0.0",
  "description": "Goal-directed research loop on Cloudflare Workers with Vectorize semantic memory",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:schema": "wrangler d1 execute research-log --remote --file=./schema.sql",
    "instances": "wrangler workflows instances list research-loop"
  },
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.1"
  }
}
